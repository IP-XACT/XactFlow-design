<?xml version="1.0" encoding="UTF-8"?>
<!-- Test fixture: a small SoC covering the common design sections, read and written back by the tests. -->
<ipxact:design xmlns:ipxact="http://www.accellera.org/XMLSchema/IPXACT/1685-2022"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xmlns:acme="http://acme.example/ext"
               xsi:schemaLocation="http://www.accellera.org/XMLSchema/IPXACT/1685-2022 http://www.accellera.org/XMLSchema/IPXACT/1685-2022/index.xsd">
  <ipxact:vendor>acme.example</ipxact:vendor>
  <ipxact:library>soc</ipxact:library>
  <ipxact:name>top_design</ipxact:name>
  <ipxact:version>1.0</ipxact:version>
  <ipxact:description>A small SoC: a cpu and two timers on one bus, with a shared reset.</ipxact:description>
  <ipxact:componentInstances>
    <ipxact:componentInstance>
      <ipxact:instanceName>cpu</ipxact:instanceName>
      <ipxact:componentRef vendor="acme.example" library="ip" name="cpu" version="2.1">
        <ipxact:configurableElementValues>
          <ipxact:configurableElementValue referenceId="DATA_WIDTH">DATA_WIDTH</ipxact:configurableElementValue>
        </ipxact:configurableElementValues>
      </ipxact:componentRef>
    </ipxact:componentInstance>
    <ipxact:componentInstance>
      <ipxact:instanceName>timer0</ipxact:instanceName>
      <ipxact:displayName>Timer 0</ipxact:displayName>
      <ipxact:componentRef vendor="acme.example" library="ip" name="timer" version="1.0"/>
    </ipxact:componentInstance>
    <ipxact:componentInstance>
      <ipxact:instanceName>timer1</ipxact:instanceName>
      <ipxact:componentRef vendor="acme.example" library="ip" name="timer" version="1.0"/>
      <ipxact:vendorExtensions>
        <acme:placement x="10" y="20"/>
      </ipxact:vendorExtensions>
    </ipxact:componentInstance>
  </ipxact:componentInstances>
  <ipxact:interconnections>
    <ipxact:interconnection>
      <ipxact:name>cpu_to_timer0</ipxact:name>
      <ipxact:activeInterface componentInstanceRef="cpu" busRef="apb_initiator"/>
      <ipxact:activeInterface componentInstanceRef="timer0" busRef="apb_target"/>
    </ipxact:interconnection>
    <ipxact:interconnection>
      <ipxact:name>timer1_export</ipxact:name>
      <ipxact:activeInterface componentInstanceRef="timer1" busRef="apb_target"/>
      <ipxact:hierInterface busRef="apb_timer1"/>
    </ipxact:interconnection>
  </ipxact:interconnections>
  <ipxact:adHocConnections>
    <!-- One reset for every instance, driven from the design's own port. -->
    <ipxact:adHocConnection>
      <ipxact:name>rst_n</ipxact:name>
      <ipxact:portReferences>
        <ipxact:internalPortReference componentInstanceRef="cpu" portRef="rst_n"/>
        <ipxact:internalPortReference componentInstanceRef="timer0" portRef="rst_n"/>
        <ipxact:internalPortReference componentInstanceRef="timer1" portRef="rst_n"/>
        <ipxact:externalPortReference portRef="rst_n"/>
      </ipxact:portReferences>
    </ipxact:adHocConnection>
    <ipxact:adHocConnection>
      <ipxact:name>irq_low</ipxact:name>
      <ipxact:portReferences>
        <ipxact:internalPortReference componentInstanceRef="cpu" portRef="irq">
          <ipxact:partSelect>
            <ipxact:range>
              <ipxact:left>1</ipxact:left>
              <ipxact:right>0</ipxact:right>
            </ipxact:range>
          </ipxact:partSelect>
        </ipxact:internalPortReference>
        <ipxact:internalPortReference componentInstanceRef="timer0" portRef="irq"/>
        <ipxact:internalPortReference componentInstanceRef="timer1" portRef="irq"/>
      </ipxact:portReferences>
    </ipxact:adHocConnection>
    <ipxact:adHocConnection>
      <ipxact:name>unused_debug</ipxact:name>
      <ipxact:tiedValue>'b0</ipxact:tiedValue>
      <ipxact:portReferences>
        <ipxact:internalPortReference componentInstanceRef="cpu" portRef="dbg_req"/>
      </ipxact:portReferences>
    </ipxact:adHocConnection>
  </ipxact:adHocConnections>
  <ipxact:parameters>
    <ipxact:parameter parameterId="DATA_WIDTH" resolve="user" type="longint">
      <ipxact:name>DATA_WIDTH</ipxact:name>
      <ipxact:value>32</ipxact:value>
    </ipxact:parameter>
  </ipxact:parameters>
</ipxact:design>
